TITLE: Valence - Mediation analysis using DSEM according to Fang et al.
DATA: FILE = "Data/MPLUS_scale_ordered_intervals2.dat";
VARIABLE:
	NAMES = userId BO VA OC UC MO intervaldays;
	USEVARIABLES = userId BO UC time;
	WITHIN = time;
	LAGGED = UC(1) BO(1);
	CLUSTER = userId;
	TINTERVAL = intervaldays(1);
	MISSING=.;
DEFINE:
	time=intervaldays;
ANALYSIS:
	TYPE = TWOLEVEL RANDOM;
	PROCESSORS = 2;
	ESTIMATOR = BAYES;
	BITERATIONS=(5000);
	THIN = 10;
  BSEED = 285380;
	
MODEL:
	%WITHIN%
	BETAxUC | UC^ ON UC^1;   !autoregressive effect
	BETAmbo | BO^ ON BO^1;   !autoregressive effect
	H2a | BO^ ON UC^1;
	trend1 | UC ON time;    !time predicts overchallenge (X)
	trend2 | BO ON time;    !time predicts boredom (M)

	
	%BETWEEN%
	[UC];[BO]; !averge individual means
	[BETAxUC]; [BETAmbo]; !average autoregressive effect
	[trend1]; [trend2]; !average of residual variance
	[H2a](a);
	UC;
	BO;
	BETAxUC;
	BETAmbo;
	H2a;
	trend1;trend2;
	
OUTPUT: tech1 tech8 cinterval(hpd) standardized (cluster);
plot: type=plot3;
