TITLE: Valence - Mediation analysis using DSEM according to Fang et al.
DATA: FILE = "../../../1_Data/2_AnalysisData/MPLUS_scale_ordered_intervals2.dat";
VARIABLE:
	NAMES = userId BO VA OC UC MO intervaldays;
	USEVARIABLES = userId UC MO time;
	WITHIN = time;
	LAGGED = MO(1) UC(1);
	CLUSTER = userId;
	TINTERVAL = intervaldays(1);
	MISSING=.;
DEFINE:
	time=intervaldays;
ANALYSIS:
	TYPE = TWOLEVEL RANDOM;
	PROCESSORS = 2;
	ESTIMATOR = BAYES;
	BITERATIONS=(5000);
	THIN = 10;
  BSEED = 285380;
	
MODEL:
	%WITHIN%
	BETAxMO | MO^ ON MO^1;   !autoregressive effect
	BETAmUC | UC^ ON UC^1;   !autoregressive effect
	H4b | MO^ ON UC^1;
	trend1 | MO ON time;    !time predicts overchallenge (X)
	trend2 | UC ON time;    !time predicts boredom (M)

	
	%BETWEEN%
	[MO];[UC]; !averge individual means
	[BETAxMO]; [BETAmUC]; !average autoregressive effect
	[trend1]; [trend2]; !average of residual variance
	[H4b](a);
	MO;
	UC;
	BETAxMO;
	BETAmUC;
	H4b;
	trend1;trend2;
	
OUTPUT: tech1 tech8 cinterval(hpd) standardized (cluster);
plot: type=plot3;
